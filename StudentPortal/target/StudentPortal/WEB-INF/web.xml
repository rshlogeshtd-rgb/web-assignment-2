<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>StudentPortal</display-name>

    <!--
        Folder that holds profile images and documents.
        Leave EMPTY to use the "uploads" folder inside the web application.
        Or set an absolute folder, e.g. C:/student_portal_uploads
        (that folder must contain the "profiles" and "documents" sub-folders).
    -->
    <context-param>
        <param-name>uploadBasePath</param-name>
        <param-value></param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- Block direct browser access to /uploads/... (files are only served by FileServlet) -->
    <security-constraint>
        <display-name>Block direct access to uploads</display-name>
        <web-resource-collection>
            <web-resource-name>Uploads</web-resource-name>
            <url-pattern>/uploads/*</url-pattern>
        </web-resource-collection>
        <auth-constraint />
    </security-constraint>

</web-app>
